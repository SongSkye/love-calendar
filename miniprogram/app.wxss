/**
 * 恋爱日历 - 全局样式
 * 主题色：粉色系，温暖浪漫
 */

/* 主题色变量（小程序不支持CSS变量，用注释标注） */
/* 主色: #FF6B81 粉红 */
/* 辅色: #FF8E9E 浅粉 */
/* 背景: #FFF5F6 浅粉背景 */
/* 文字: #333333 深灰 */
/* 辅助文字: #999999 浅灰 */

page {
  background-color: #FFF5F6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 通用容器 ===== */
.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 卡片样式 ===== */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 129, 0.08);
}

/* ===== 按钮样式 ===== */
.btn-primary {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  border-radius: 50rpx;
  border: none;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-outline {
  background: #FFFFFF;
  color: #FF6B81;
  border: 2rpx solid #FF6B81;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
}

/* ===== 输入框样式 ===== */
.input-field {
  background: #FFF5F6;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.3s;
}

.input-field:focus {
  border-color: #FF6B81;
}

/* ===== 表情选择器 ===== */
.mood-selector {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
}

.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.mood-item.active {
  background: #FFF5F6;
  transform: scale(1.15);
}

.mood-emoji {
  font-size: 64rpx;
  margin-bottom: 10rpx;
}

.mood-label {
  font-size: 22rpx;
  color: #999999;
}

/* ===== 纪念日卡片 ===== */
.anniversary-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #FF6B81;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.anniversary-card.birthday {
  border-left-color: #FFB347;
}

.anniversary-card.custom {
  border-left-color: #87CEEB;
}

/* ===== 日记列表 ===== */
.diary-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.diary-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.diary-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* ===== 顶部信息卡片 ===== */
.header-card {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 129, 0.25);
}

.header-card .days {
  font-size: 72rpx;
  font-weight: bold;
}

.header-card .subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* ===== 日历组件定制 ===== */
.calendar-container {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 129, 0.08);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #CCCCCC;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
}

/* ===== 加载状态 ===== */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 24rpx;
}

/* ===== 浮动按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.9);
}

/* ===== 弹窗内容 ===== */
.popup-content {
  padding: 30rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333333;
}

/* ===== 图片上传区域 ===== */
.image-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.image-upload-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.image-upload-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-upload-item .delete-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
}

.image-add-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #FF6B81;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FF6B81;
  font-size: 24rpx;
  background: #FFF5F6;
}

.image-add-btn .add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

/* ===== 欢迎页 ===== */
.welcome-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx;
  box-sizing: border-box;
}

.welcome-logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B81;
  margin-bottom: 20rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 60rpx;
  text-align: center;
}

/* ===== 我的页面 ===== */
.mine-header {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  padding: 60rpx 30rpx 40rpx;
  text-align: center;
  color: #FFFFFF;
}

.mine-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-bottom: 20rpx;
}

.mine-nickname {
  font-size: 36rpx;
  font-weight: bold;
}

/* ===== 邀请码展示 ===== */
.invite-code-display {
  text-align: center;
  padding: 40rpx;
}

.invite-code {
  font-size: 72rpx;
  font-weight: bold;
  color: #FF6B81;
  letter-spacing: 16rpx;
  margin: 30rpx 0;
}

/* ===== 时间标签 ===== */
.tag-me {
  background: #FF6B81;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.tag-partner {
  background: #FFB347;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}