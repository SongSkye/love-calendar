/* 卡片图鉴页面样式 */
.collection-page {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #FFF5F6;
  padding-bottom: 120rpx;
}

/* ===== 顶部统计 ===== */
.collection-header {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.collection-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

.collection-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #FF6B81;
  font-weight: bold;
}

.progress-bar-wrap {
  width: 400rpx;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #FFB3BF, #FF6B81);
  transition: width 0.5s ease;
}

/* ===== 套系切换 ===== */
.set-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding: 8rpx 0;
}

.set-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.set-tab.active {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
}

.set-tab-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: bold;
}

.set-tab.active .set-tab-name {
  color: #FFFFFF;
}

.set-tab-progress {
  font-size: 22rpx;
  color: #999999;
}

.set-tab.active .set-tab-progress {
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 卡片网格 ===== */
.cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.card-item {
  width: calc(50% - 8rpx);
}

.card-inner {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 3rpx solid;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 260rpx;
  position: relative;
}

.card-inner.locked {
  border-color: #E0E0E0 !important;
  background: #F5F5F5;
  box-shadow: none !important;
}

.card-emoji {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.card-rarity-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  color: #FFFFFF;
}

.card-rarity-tag.locked-tag {
  background: #D0D0D0 !important;
}

.card-locked-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  opacity: 0.4;
}

.card-locked-label {
  font-size: 28rpx;
  color: #CCCCCC;
  font-weight: bold;
}

/* ===== 空状态 ===== */
.empty-collection {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* ===== 底部按钮 ===== */
.collection-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(180deg, rgba(255, 245, 246, 0), #FFF5F6 40%);
  display: flex;
  justify-content: center;
}

.go-gacha-btn {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.3);
  text-align: center;
}