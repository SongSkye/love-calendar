/* 旅行详情页样式 */
.detail-page {
  min-height: 100vh;
  background: #FFF5F6;
  padding-bottom: 160rpx;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
}

/* 顶部封面 */
.detail-cover {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF8E9E, #FF6B81);
}

.cover-default .cover-icon {
  font-size: 100rpx;
}

.cover-info {
  position: absolute;
  left: 30rpx;
  bottom: 30rpx;
  right: 200rpx;
}

.cover-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 8rpx;
}

.cover-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.cover-countdown {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(8rpx);
}

.countdown-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 1.1;
}

.countdown-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 基本信息 */
.info-card {
  margin: 20rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.info-key {
  width: 100rpx;
  color: #FF6B81;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  color: #555555;
  line-height: 1.5;
}

/* 通用 section */
.section {
  margin: 20rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.overview-item {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.overview-day {
  width: 110rpx;
  color: #FF6B81;
  font-weight: bold;
  flex-shrink: 0;
}

.overview-text {
  flex: 1;
  color: #555;
  line-height: 1.5;
}

.tip-item {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  padding: 6rpx 0;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #FF6B81;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-btn.danger {
  color: #FF4D4F;
}

.action-btn:active {
  opacity: 0.7;
}

/* 分区 tab 栏 */
.cat-tabs {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 20rpx;
  margin-bottom: 12rpx;
}

.cat-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.cat-tab.active {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
}

.cat-tab-emoji {
  font-size: 32rpx;
}

.cat-tab-name {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.cat-tab.active .cat-tab-name {
  color: #FFFFFF;
}

/* 明细区 */
.items-area {
  padding: 0 20rpx;
}

.items-empty {
  padding: 80rpx 0;
  text-align: center;
}

.items-empty .empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.items-empty .empty-text {
  font-size: 26rpx;
  color: #BBB;
}

/* 按天分组（itinerary） */
.day-group {
  margin-bottom: 24rpx;
}

.day-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 4rpx 12rpx;
}

.day-badge {
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 20rpx;
}

.day-lodging {
  font-size: 22rpx;
  color: #888;
}

/* 明细卡片 */
.item-card {
  display: flex;
  align-items: stretch;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-main {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
}

.item-card:active .item-main {
  opacity: 0.7;
}

.item-row1 {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.item-time {
  font-size: 24rpx;
  color: #FF6B81;
  font-weight: bold;
  flex-shrink: 0;
  min-width: 120rpx;
}

.item-activity {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: #888;
  background: #FFF0F2;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.item-remark {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* 预订状态角标（卡片右上角） */
.booking-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: auto;
}
.booking-badge.booked {
  color: #FFFFFF;
  background: #52C41A;
}
.booking-badge.pending {
  color: #FA8C16;
  background: #FFF7E6;
}

/* 已订卡片左侧加绿色竖条，置顶时一眼可见 */
.item-card.is-booked {
  border-left: 6rpx solid #52C41A;
}

.item-del {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #CCCCCC;
  background: #FAFAFA;
}

.item-del:active {
  color: #FF4D4F;
  background: #FFF0F0;
}

/* 浮动新增 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.9);
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 88%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-title {
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  border-bottom: 1rpx solid #EEEEEE;
}

.modal-form {
  max-height: 60vh;
  padding: 12rpx 28rpx;
}

.form-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #FF6B81;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 16rpx 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
  min-height: 40rpx;
}

/* 弹窗内预订状态选择器 */
.booking-picker {
  padding: 0;
  background: transparent;
}
.booking-val {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.booking-val.booked {
  color: #52C41A;
  background: #F6FFED;
}
.booking-val.pending {
  color: #FA8C16;
  background: #FFF7E6;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #EEEEEE;
}

.modal-btn {
  flex: 1;
  border-radius: 0;
  font-size: 28rpx;
  background: #FFFFFF;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  color: #999;
  border-right: 1rpx solid #EEEEEE;
}

.modal-btn.confirm {
  color: #FF6B81;
  font-weight: bold;
}
