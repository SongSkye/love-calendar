<!--
  日历页 - 首页Tab
  功能：月历展示两人心情、记录心情、顶部显示在一起天数
-->
<view class="calendar-page">
  <!-- 头部信息卡片 -->
  <view class="header-card {{todayAnniversary ? 'anniversary-today' : ''}}">
    <view class="header-left">
      <view class="together-days">
        <text class="days-number">{{togetherDays}}</text>
        <text class="days-unit">天</text>
      </view>
      <view class="together-label">在一起</view>
      <!-- 纪念日当天提示 -->
      <view class="anniversary-today-label" wx:if="{{todayAnniversary}}">
        🎉 今天是「{{todayAnniversary.title}}」
      </view>
    </view>
    <view class="header-right">
      <view class="next-anniversary" wx:if="{{nextAnniversary}}">
        <text class="next-label">距「{{nextAnniversary.title}}」</text>
        <text class="next-countdown">{{nextAnniversary.countdownDays}}天</text>
      </view>
      <view class="no-anniversary" wx:else>
        <text>添加纪念日吧 💝</text>
      </view>
    </view>
  </view>

  <!-- 婚礼倒计时卡片 -->
  <view class="wedding-countdown-card {{weddingCountdown.isPast ? 'wedding-past' : ''}} {{weddingCountdown.isToday ? 'wedding-today' : ''}}" wx:if="{{weddingCountdown}}">
    <view class="wedding-bg-decor"></view>
    <view class="wedding-left">
      <text class="wedding-icon">{{weddingCountdown.isPast ? '💍' : (weddingCountdown.isToday ? '🎉' : '💒')}}</text>
      <view class="wedding-info">
        <text class="wedding-label" wx:if="{{weddingCountdown.isPast}}">「{{weddingCountdown.title}}」已过去</text>
        <text class="wedding-label" wx:elif="{{weddingCountdown.isToday}}">🎉 今天就是「{{weddingCountdown.title}}」！</text>
        <text class="wedding-label" wx:else>距「{{weddingCountdown.title}}」还有</text>
        <text class="wedding-date">{{weddingCountdown.date}}</text>
      </view>
    </view>
    <view class="wedding-right">
      <text class="wedding-days">{{weddingCountdown.isPast ? weddingCountdown.totalDays : (weddingCountdown.isToday ? '🎉' : weddingCountdown.countdownDays)}}</text>
      <text class="wedding-unit">{{weddingCountdown.isPast ? '天' : (weddingCountdown.isToday ? '' : '天')}}</text>
    </view>
  </view>

  <!-- 悄悄话卡片 -->
  <view class="love-note-card" wx:if="{{loveNote}}" bindtap="openLoveNotePopup">
    <view class="love-note-header">
      <text class="love-note-icon">💌</text>
      <text class="love-note-label">TA 今天想对你说</text>
      <view class="love-note-unread" wx:if="{{!loveNote.isRead}}"></view>
    </view>
    <text class="love-note-text">{{loveNote.content}}</text>
  </view>

  <view class="love-note-card love-note-sent" wx:elif="{{myLoveNote}}" bindtap="openLoveNotePopup">
    <text class="love-note-icon">💌</text>
    <text class="love-note-text">今日悄悄话已发送 ✅</text>
    <text class="love-note-preview">{{myLoveNote.content}}</text>
  </view>

  <view class="love-note-card love-note-empty" wx:else bindtap="openLoveNotePopup">
    <text class="love-note-icon">💌</text>
    <text class="love-note-label">给TA写一句悄悄话...</text>
  </view>

  <!-- 月历 -->
  <view class="calendar-container">
    <!-- 月份切换 -->
    <view class="month-header">
      <view class="month-arrow" bindtap="prevMonth">◀</view>
      <view class="month-title">{{currentYear}}年{{currentMonth}}月</view>
      <view class="month-arrow" bindtap="nextMonth">▶</view>
    </view>

    <!-- 星期标题 -->
    <view class="weekday-row">
      <view class="weekday-item" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>

    <!-- 日期格子 -->
    <view class="date-grid">
      <view
        class="date-cell {{item.empty ? 'empty' : ''}} {{item.isToday ? 'today' : ''}} {{item.isToday && todayAnniversary ? 'today-anniversary' : ''}}"
        wx:for="{{calendarGrid}}"
        wx:key="index"
        data-date="{{item.date}}"
        data-empty="{{item.empty}}"
        bindtap="onDateTap"
      >
        <view class="date-num" wx:if="{{!item.empty}}">{{item.day}}</view>
        <!-- 纪念日角标 -->
        <view class="anniversary-mark" wx:if="{{!item.empty && anniversaryDateMap[item.date.substring(5)]}}">
          <text
            wx:for="{{anniversaryDateMap[item.date.substring(5)]}}"
            wx:key="_id"
            wx:for-item="mark"
            wx:if="{{index < 2}}"
          >{{mark.type === 'together' ? '❤️' : (mark.type === 'birthday' ? '🎂' : (mark.type === 'wedding' ? '💒' : '⭐'))}}</text>
          <text wx:if="{{anniversaryDateMap[item.date.substring(5)].length > 2}}">...</text>
        </view>
        <!-- 心情表情 -->
        <view class="mood-row" wx:if="{{!item.empty && moodMap[item.date]}}">
          <text
            class="mood-emoji-small"
            wx:for="{{moodMap[item.date].users}}"
            wx:key="uid"
            wx:for-item="moodItem"
          >{{moodItem.emoji}}</text>
        </view>
        <!-- 有照片的小圆点 -->
        <view class="has-photo-dot" wx:if="{{!item.empty && moodMap[item.date] && moodMap[item.date].hasPhoto}}"></view>
      </view>
    </view>
  </view>

  <!-- 今日心情快速入口 -->
  <view class="today-mood-entry" wx:if="{{!hasTodayMood}}">
    <view class="today-mood-card" bindtap="onDateTap" data-date="{{todayDate}}">
      <text class="today-icon">📝</text>
      <text class="today-text">记录今天的心情吧～</text>
    </view>
  </view>

  <!-- ===== 心情统计卡片 ===== -->
  <view class="mood-stats-card">
    <view class="stats-header">
      <text class="stats-title">📊 心情统计</text>
      <view class="stats-range-tabs">
        <text
          class="stats-range-tab {{statRange === 'month' ? 'active' : ''}}"
          data-range="month"
          bindtap="switchStatRange"
        >当月</text>
        <text
          class="stats-range-tab {{statRange === 'year' ? 'active' : ''}}"
          data-range="year"
          bindtap="switchStatRange"
        >今年</text>
        <text
          class="stats-range-tab {{statRange === 'all' ? 'active' : ''}}"
          data-range="all"
          bindtap="switchStatRange"
        >全部</text>
      </view>
    </view>

    <view class="stats-list">
      <view
        class="stats-item"
        wx:for="{{moodStats}}"
        wx:key="key"
        wx:for-item="stat"
      >
        <view class="stats-item-left">
          <text class="stats-emoji">{{stat.emoji}}</text>
          <text class="stats-label">{{stat.label}}</text>
        </view>
        <view class="stats-bar-wrap">
          <view class="stats-bar" style="width: {{stat.percent}}%"></view>
        </view>
        <text class="stats-count">{{stat.count}}</text>
      </view>
    </view>

    <view class="stats-footer" wx:if="{{moodStatsTotal > 0}}">
      <text class="stats-total">共记录 {{moodStatsTotal}} 条心情</text>
      <text class="stats-top">📈 {{moodStatsTopLabel}}占比 {{moodStatsTopPercent}}%</text>
    </view>
    <view class="stats-empty" wx:else>
      <text>暂无心情记录，开始记录你们的每一天吧 💕</text>
    </view>
  </view>
</view>

<!-- 心情记录弹窗 -->
<view class="mood-popup-mask" wx:if="{{showMoodPopup}}" bindtap="closeMoodPopup">
  <view class="mood-popup" catchtap="noop">
    <view class="popup-header">
      <text class="popup-title">{{popupDate}} {{isEditing ? '修改心情' : '记录心情'}}</text>
      <view class="popup-close" bindtap="closeMoodPopup">✕</view>
    </view>

    <!-- 心情选择 -->
    <view class="mood-selector">
      <view
        class="mood-item {{selectedMood === item.key ? 'active' : ''}}"
        wx:for="{{moodOptions}}"
        wx:key="key"
        data-mood="{{item.key}}"
        bindtap="selectMood"
      >
        <text class="mood-emoji">{{item.emoji}}</text>
        <text class="mood-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="form-group">
      <textarea
        class="mood-note"
        placeholder="写点什么吧...（选填）"
        value="{{moodNote}}"
        bindinput="onMoodNoteInput"
        maxlength="200"
        auto-height
      />
    </view>

    <!-- 图片上传 -->
    <view class="image-section">
      <view class="section-label">📷 日常照片（选填，最多9张）</view>
      <view class="image-upload-area">
        <block wx:for="{{moodImages}}" wx:key="index">
          <view class="image-upload-item">
            <image src="{{item}}" mode="aspectFill" bindtap="previewMoodImage" data-index="{{index}}"></image>
            <view class="delete-btn" catchtap="deleteMoodImage" data-index="{{index}}">✕</view>
          </view>
        </block>
        <view class="image-add-btn" wx:if="{{moodImages.length < 9}}" bindtap="addMoodImage">
          <text class="add-icon">+</text>
          <text>添加照片</text>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <button class="btn-save-mood" bindtap="saveMood" loading="{{savingMood}}">保存心情</button>
  </view>
</view>

<!-- 查看心情详情弹窗 -->
<view class="mood-popup-mask" wx:if="{{showMoodDetail}}" bindtap="closeMoodDetail">
  <view class="mood-popup" catchtap="noop">
    <view class="popup-header">
      <text class="popup-title">{{popupDate}} 心情</text>
      <view class="popup-close" bindtap="closeMoodDetail">✕</view>
    </view>
    <view wx:for="{{moodDetailList}}" wx:key="uid" class="mood-detail-item">
      <view class="mood-detail-header">
        <text class="mood-detail-nickname">💕 {{item.nickname}}</text>
        <text class="mood-detail-emoji">{{item.emoji}} {{item.label}}</text>
      </view>
      <view class="mood-detail-note" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="mood-detail-images" wx:if="{{item.images && item.images.length > 0}}">
        <image
          wx:for="{{item.images}}"
          wx:key="index"
          wx:for-item="img"
          src="{{img}}"
          mode="aspectFill"
          class="mood-detail-image"
          bindtap="previewDetailImage"
          data-url="{{img}}"
          data-urls="{{item.images}}"
        ></image>
      </view>
      <view class="mood-detail-edit" wx:if="{{item.isMine}}" bindtap="editMoodFromDetail" data-item="{{item}}">修改</view>
    </view>
  </view>
</view>

<!-- 悄悄话弹窗 -->
<view class="mood-popup-mask" wx:if="{{showLoveNotePopup}}" bindtap="closeLoveNotePopup">
  <view class="mood-popup" catchtap="noop">
    <view class="popup-header">
      <text class="popup-title">今日想对TA说...</text>
      <view class="popup-close" bindtap="closeLoveNotePopup">✕</view>
    </view>
    <view class="form-group">
      <textarea
        class="mood-note"
        placeholder="写一句悄悄话吧（最多200字）"
        value="{{loveNoteContent}}"
        bindinput="onLoveNoteInput"
        maxlength="200"
        auto-height
      />
    </view>
    <button class="btn-save-mood" bindtap="saveLoveNote" loading="{{savingLoveNote}}">发送悄悄话</button>
  </view>
</view>

<!-- 纪念日庆祝弹窗 -->
<view class="mood-popup-mask celebration-mask" wx:if="{{showCelebrationPopup}}" bindtap="closeCelebrationPopup">
  <view class="celebration-popup" catchtap="noop">
    <text class="celebration-big-emoji">🎉</text>
    <text class="celebration-title">今天是「{{todayAnniversary.title}}」</text>
    <text class="celebration-days">已经 {{todayAnniversary.totalDays}} 天啦 💕</text>
    <view class="celebration-btn" bindtap="closeCelebrationPopup">知道啦</view>
  </view>
</view>