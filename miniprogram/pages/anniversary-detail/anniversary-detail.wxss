/* 纪念日详情页样式 */
.detail-page {
  min-height: 100vh;
  background: #FFF5F6;
  padding-bottom: 60rpx;
}

.loading-box {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

/* 封面 */
.detail-cover {
  width: 100%;
  height: 400rpx;
  position: relative;
  overflow: hidden;
}

.detail-cover .cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.detail-cover .cover-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
}

.detail-cover .cover-icon {
  font-size: 120rpx;
}

.cover-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 30rpx 30rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
  color: #FFFFFF;
}

.cover-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.cover-date {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 倒计时卡片 */
.countdown-card {
  background: #FFFFFF;
  margin: -30rpx 20rpx 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  position: relative;
  z-index: 1;
}

.countdown-big {
  font-size: 64rpx;
  font-weight: bold;
  color: #FF6B81;
}

.countdown-unit {
  font-size: 28rpx;
  color: #FF6B81;
  margin-left: 4rpx;
}

.countdown-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 操作按钮 */
.action-row {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  padding: 20rpx 30rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #FF6B81;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 50rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

/* 年份网格 */
.year-grid-section {
  padding: 20rpx;
  margin-bottom: 10rpx;
}

.year-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.year-cell {
  width: 150rpx;
  padding: 16rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.year-cell.has-record {
  border-color: #FF6B81;
  background: #FFE8EC;
}

.year-num {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.year-cell.has-record .year-num {
  color: #FF6B81;
}

.year-status {
  display: block;
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 历史记录 */
.history-section {
  padding: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.history-list {
  position: relative;
  padding-left: 40rpx;
}

.history-list::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #FF6B81;
  opacity: 0.3;
}

.history-item {
  display: flex;
  margin-bottom: 30rpx;
  position: relative;
}

.history-item::before {
  content: '';
  position: absolute;
  left: -28rpx;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B81;
  border: 4rpx solid #FFF5F6;
}

.history-year {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFF;
  font-size: 28rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 50rpx;
  margin-right: 20rpx;
  white-space: nowrap;
  align-self: flex-start;
}

.history-body {
  flex: 1;
  background: #FFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.history-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.history-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.history-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  object-fit: cover;
}

.history-author {
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #CCC;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #DDD;
}