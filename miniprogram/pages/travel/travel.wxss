/* 旅行计划列表页样式 */
.travel-page {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 140rpx;
}

/* 出行准备入口卡片 */
/* 出行准备入口（紧凑单行，区别于下方旅行卡片） */
.packing-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.packing-entry:active {
  opacity: 0.7;
}
.packing-entry-emoji {
  font-size: 32rpx;
}
.packing-entry-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.packing-entry-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  flex-shrink: 0;
}
.packing-entry-desc {
  font-size: 22rpx;
  color: #BBBBBB;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.packing-entry-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}

/* 出行准备弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  width: 88%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.packing-box-modal {
  max-height: 85vh;
}
.modal-title {
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  border-bottom: 1rpx solid #EEEEEE;
}
.packing-scroll {
  max-height: 65vh;
  padding: 12rpx 28rpx;
}
.packing-cat {
  margin-bottom: 24rpx;
}
.packing-cat-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B81;
  margin-bottom: 10rpx;
}
.packing-li {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
  padding: 4rpx 0 4rpx 16rpx;
}
.packing-cat-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.packing-cat-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B81;
  border-bottom: 2rpx solid #FFE4E8;
  padding: 6rpx 0;
}
.packing-cat-del {
  font-size: 22rpx;
  color: #FF4D4F;
  padding: 6rpx 16rpx;
  border: 2rpx solid #FF4D4F;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.packing-edit-li {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.packing-item-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  background: #F9F9F9;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.packing-item-del {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}
.packing-add-item {
  font-size: 24rpx;
  color: #FF6B81;
  padding: 8rpx 16rpx;
  margin-bottom: 8rpx;
}
.packing-add-cat {
  font-size: 26rpx;
  color: #FF6B81;
  text-align: center;
  padding: 16rpx;
  border: 2rpx dashed #FFB3C0;
  border-radius: 16rpx;
  margin-top: 8rpx;
}
.modal-actions {
  display: flex;
  border-top: 1rpx solid #EEEEEE;
}
.modal-btn {
  flex: 1;
  border-radius: 0;
  font-size: 28rpx;
  background: #FFFFFF;
  border: none;
}
.modal-btn::after {
  border: none;
}
.modal-btn.cancel {
  color: #999;
  border-right: 1rpx solid #EEEEEE;
}
.modal-btn.confirm {
  color: #FF6B81;
  font-weight: bold;
}

/* 加载/空状态 */
.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
}

.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #BBBBBB;
  margin-bottom: 48rpx;
}

.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.sample-btn {
  width: 80%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

.sample-btn:active {
  transform: scale(0.98);
}

.empty-add-btn {
  width: 80%;
  padding: 24rpx 0;
  background: #FFFFFF;
  color: #FF6B81;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  border: 2rpx solid #FF6B81;
}

.empty-add-btn:active {
  opacity: 0.7;
}

/* 旅行卡片 */
.travel-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.travel-card:active {
  transform: scale(0.98);
}

/* 封面图 */
.card-cover {
  width: 100%;
  height: 240rpx;
  position: relative;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF5F6, #FFE4E8);
}

.cover-default .cover-icon {
  font-size: 80rpx;
}

.cover-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 18rpx;
  background: rgba(255, 107, 129, 0.9);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 卡片主体 */
.card-body {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.card-left {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* 无封面时，类型标签跟在标题后 */
.title-tag {
  font-size: 20rpx;
  color: #FF6B81;
  background: rgba(255, 107, 129, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.card-route {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 6rpx;
}

.card-date {
  font-size: 24rpx;
  color: #AAAAAA;
}

.card-right {
  padding-left: 20rpx;
}

.card-countdown {
  text-align: center;
}

.countdown-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B81;
  line-height: 1.1;
}

.countdown-label {
  font-size: 22rpx;
  color: #999999;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.9);
}
