/* 旅行计划列表页样式 */
.travel-page {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 140rpx;
}

/* 加载/空状态 */
.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
}

.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #BBBBBB;
  margin-bottom: 48rpx;
}

.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.sample-btn {
  width: 80%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

.sample-btn:active {
  transform: scale(0.98);
}

.empty-add-btn {
  width: 80%;
  padding: 24rpx 0;
  background: #FFFFFF;
  color: #FF6B81;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  border: 2rpx solid #FF6B81;
}

.empty-add-btn:active {
  opacity: 0.7;
}

/* 旅行卡片 */
.travel-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.travel-card:active {
  transform: scale(0.98);
}

/* 封面图 */
.card-cover {
  width: 100%;
  height: 240rpx;
  position: relative;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF5F6, #FFE4E8);
}

.cover-default .cover-icon {
  font-size: 80rpx;
}

.cover-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 18rpx;
  background: rgba(255, 107, 129, 0.9);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 卡片主体 */
.card-body {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.card-left {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-route {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 6rpx;
}

.card-date {
  font-size: 24rpx;
  color: #AAAAAA;
}

.card-right {
  padding-left: 20rpx;
}

.card-countdown {
  text-align: center;
}

.countdown-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B81;
  line-height: 1.1;
}

.countdown-label {
  font-size: 22rpx;
  color: #999999;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.9);
}
