<!-- 旅行计划列表页 -->
<view class="travel-page">
  <!-- 出行准备入口（通用清单，所有旅行共用，点击查看/编辑） -->
  <view class="packing-entry" bindtap="togglePacking">
    <text class="packing-entry-emoji">🎒</text>
    <view class="packing-entry-info">
      <text class="packing-entry-title">出行准备</text>
      <text class="packing-entry-desc">通用打包清单，点此查看 / 编辑</text>
    </view>
    <text class="packing-entry-arrow">›</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-box" wx:if="{{loading && trips.length === 0}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{trips.length === 0 && !loading}}">
    <view class="empty-icon">✈️</view>
    <view class="empty-text">还没有旅行计划</view>
    <view class="empty-sub">添加属于你们的旅行吧</view>
    <view class="empty-actions">
      <view class="sample-btn" bindtap="loadSample">📋 加载大理蜜月攻略示例</view>
      <view class="empty-add-btn" bindtap="addTrip">+ 新建旅行</view>
    </view>
  </view>

  <!-- 旅行卡片列表 -->
  <view class="travel-list" wx:if="{{trips.length > 0}}">
    <view
      class="travel-card"
      wx:for="{{trips}}"
      wx:key="_id"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <!-- 封面图（无封面时不显示占位框，直接展示下方卡片信息） -->
      <view class="card-cover" wx:if="{{item.coverImage}}">
        <image src="{{item.coverImage}}" mode="aspectFill" class="cover-img"></image>
        <view class="cover-tag">{{item.travelType || '旅行'}}</view>
      </view>

      <view class="card-body">
        <view class="card-left">
          <view class="card-title">
            <text class="title-text">{{item.title}}</text>
            <text class="title-tag" wx:if="{{!item.coverImage && item.travelType}}">{{item.travelType}}</text>
          </view>
          <view class="card-route">📍 {{item.departure}} → {{item.destination}}</view>
          <view class="card-date">📅 {{item.startDate}} ~ {{item.endDate}}</view>
        </view>
        <view class="card-right">
          <view class="card-countdown">
            <text class="countdown-num">{{item.countdown}}</text>
            <text class="countdown-label">{{item.countdownLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 浮动新增按钮 -->
  <view class="fab" bindtap="addTrip" wx:if="{{trips.length > 0}}">+</view>
</view>

<!-- 出行准备清单弹窗（查看 + 编辑，双方共享同步） -->
<view class="modal-mask" wx:if="{{showPackingModal}}" bindtap="closePacking">
  <view class="modal-box packing-box-modal" catchtap="noop">
    <view class="modal-title">🎒 出行准备</view>

    <!-- 查看模式 -->
    <block wx:if="{{!packingEditing}}">
      <scroll-view scroll-y class="packing-scroll">
        <view class="packing-cat" wx:for="{{packingList}}" wx:key="category" wx:for-item="cat" wx:for-index="catIdx">
          <view class="packing-cat-title">{{cat.emoji}} {{cat.category}}</view>
          <view class="packing-li" wx:for="{{cat.items}}" wx:key="*this" wx:for-item="li">· {{li}}</view>
        </view>
      </scroll-view>
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="closePacking">关闭</button>
        <button class="modal-btn confirm" bindtap="editPacking">✏️ 编辑</button>
      </view>
    </block>

    <!-- 编辑模式 -->
    <block wx:else>
      <scroll-view scroll-y class="packing-scroll">
        <view class="packing-cat" wx:for="{{packingDraft}}" wx:key="category" wx:for-item="cat" wx:for-index="catIdx">
          <view class="packing-cat-head">
            <input class="packing-cat-input" value="{{cat.category}}" data-cat="{{catIdx}}" bindinput="onPackingCategoryInput" placeholder="类别" />
            <view class="packing-cat-del" catchtap="removePackingCategory" data-cat="{{catIdx}}">删</view>
          </view>
          <view class="packing-edit-li" wx:for="{{cat.items}}" wx:key="*this" wx:for-item="li" wx:for-index="idx">
            <input class="packing-item-input" value="{{li}}" data-cat="{{catIdx}}" data-idx="{{idx}}" bindinput="onPackingItemInput" placeholder="物品" />
            <view class="packing-item-del" catchtap="removePackingItem" data-cat="{{catIdx}}" data-idx="{{idx}}">×</view>
          </view>
          <view class="packing-add-item" catchtap="addPackingItem" data-cat="{{catIdx}}">+ 添加物品</view>
        </view>
        <view class="packing-add-cat" catchtap="addPackingCategory">+ 添加类别</view>
      </scroll-view>
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="cancelEditPacking">取消</button>
        <button class="modal-btn confirm" bindtap="savePacking" loading="{{packingSaving}}">保存</button>
      </view>
    </block>
  </view>
</view>
