<!--
  日记编辑页 - 新增/编辑日记
  支持文字内容 + 图片上传
-->
<view class="edit-page">
  <!-- 日期选择 -->
  <view class="form-group">
    <view class="form-label">日期</view>
    <picker mode="date" value="{{diaryDate}}" bindchange="onDateChange">
      <view class="date-picker">{{diaryDate}}</view>
    </picker>
  </view>

  <!-- 标题 -->
  <view class="form-group">
    <view class="form-label">标题（选填）</view>
    <input
      class="form-input"
      placeholder="给日记起个标题..."
      value="{{title}}"
      bindinput="onTitleInput"
      maxlength="50"
    />
  </view>

  <!-- 内容 -->
  <view class="form-group">
    <view class="form-label">内容</view>
    <textarea
      class="content-input"
      placeholder="今天发生了什么有趣的事..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="5000"
      auto-height
    />
  </view>

  <!-- 图片 -->
  <view class="form-group">
    <view class="form-label">📷 照片（选填，最多9张）</view>
    <view class="image-upload-area">
      <block wx:for="{{images}}" wx:key="index">
        <view class="image-upload-item">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
          <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">✕</view>
        </view>
      </block>
      <view class="image-add-btn" wx:if="{{images.length < 9}}" bindtap="addImage">
        <text class="add-icon">+</text>
        <text>添加照片</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-area">
    <button class="btn-save" bindtap="saveDiary" loading="{{saving}}">
      {{isEdit ? '保存修改' : '发布日记'}}
    </button>
  </view>
</view>