/* 纪念日列表页样式 - 带封面图 */
.anniversary-page {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 140rpx;
}

/* 纪念日卡片 */
.anniversary-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.anniversary-card:active {
  transform: scale(0.98);
}

/* 封面图 */
.card-cover {
  width: 100%;
  height: 240rpx;
  position: relative;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF5F6, #FFE4E8);
}

.cover-default .cover-icon {
  font-size: 80rpx;
}

.anniversary-card.together .cover-default {
  background: linear-gradient(135deg, #FFF5F6, #FFE4E8);
}

.anniversary-card.birthday .cover-default {
  background: linear-gradient(135deg, #FFF8F0, #FFE8D0);
}

.anniversary-card.custom .cover-default {
  background: linear-gradient(135deg, #F0F8FF, #D0E8FF);
}

/* 卡片主体 */
.card-body {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.card-left {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 6rpx;
}

.card-date {
  font-size: 24rpx;
  color: #999999;
}

.card-right {
  padding-left: 20rpx;
}

.card-countdown {
  text-align: center;
}

.countdown-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B81;
}

.countdown-label {
  font-size: 22rpx;
  color: #999999;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.9);
}

.empty-sub {
  font-size: 24rpx;
  color: #DDDDDD;
  margin-top: 8rpx;
}