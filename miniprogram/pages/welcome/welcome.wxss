/* 欢迎页样式 */
.welcome-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F6 0%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 品牌区域 */
.brand-area {
  text-align: center;
  padding: 100rpx 0 40rpx;
}

.brand-area .logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.brand-area .app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B81;
  margin-bottom: 12rpx;
}

.brand-area .app-desc {
  font-size: 26rpx;
  color: #999999;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #F5F5F5;
  border-radius: 50rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #999999;
  border-radius: 50rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #FFFFFF;
  color: #FF6B81;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 表单区域 */
.form-area {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.form-input {
  background: #FFF5F6;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.3s;
}

.form-input:focus {
  border-color: #FF6B81;
}

.code-input {
  font-size: 36rpx;
  letter-spacing: 16rpx;
  text-align: center;
  font-weight: bold;
}

/* 按钮 */
.btn-create {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.3);
}

.btn-create[disabled] {
  opacity: 0.6;
}

/* 邀请码结果 */
.invite-result {
  margin-top: 40rpx;
  text-align: center;
}

.invite-tip {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.invite-code-box {
  background: #FFF5F6;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx dashed #FF6B81;
}

.invite-code-text {
  font-size: 64rpx;
  font-weight: bold;
  color: #FF6B81;
  letter-spacing: 20rpx;
}

.invite-actions {
  display: flex;
  gap: 20rpx;
}

.btn-copy {
  flex: 1;
  background: #FFFFFF;
  color: #FF6B81;
  border: 2rpx solid #FF6B81;
  border-radius: 50rpx;
  font-size: 26rpx;
  padding: 18rpx 0;
}

.btn-enter {
  flex: 1;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 26rpx;
  padding: 18rpx 0;
  border: none;
}

/* 底部说明 */
.footer-note {
  text-align: center;
  padding: 60rpx 0;
  font-size: 24rpx;
  color: #CCCCCC;
  margin-top: auto;
}