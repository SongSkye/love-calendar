/* 照片墙页面样式 */
.photos-page {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载中 */
.loading-box {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #CCCCCC;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #DDDDDD;
}

/* 日期分组 */
.photo-group {
  margin-bottom: 32rpx;
}

.group-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.group-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.group-label {
  font-size: 22rpx;
  color: #999999;
}

/* 照片网格 — 两列布局 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.photo-item {
  width: calc(50% - 5rpx);
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.photo-img {
  width: 100%;
  height: 260rpx;
  display: block;
}

.photo-info {
  padding: 12rpx 14rpx;
}

.photo-source {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.source-tag {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.tag-mood {
  background: #FFF0F2;
  color: #FF6B81;
}

.tag-diary {
  background: #F0F4FF;
  color: #6B8EFF;
}

.photo-author {
  font-size: 20rpx;
  color: #999999;
}

.photo-note {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}